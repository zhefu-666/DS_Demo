# replay_lio 对比：三种算法的话题都列出，launch 用 -f 设置当前算法的固定帧：
#   point_lio -> camera_init   fast_lio -> fastlio_odom   small_point_lio -> odom
# 未运行的算法显示 No messages，属正常。
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 1
      Plane Cell Count: 40
      Color: 160; 160; 164
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Arrows: false
      Marker Scale: 0.5
    - Class: rviz_common/Group
      Name: Point-LIO
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/PointCloud2
          Name: cloud_registered（当前帧，世界系）
          Enabled: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /cloud_registered
          Style: Points
          Size (Pixels): 2
          Size (m): 0.03
          Alpha: 1.0
          Decay Time: 10
          Position Transformer: XYZ
          Color Transformer: Intensity
          Use rainbow: true
          Invert Rainbow: false
          Autocompute Intensity Bounds: true
        - Class: rviz_default_plugins/Odometry
          Name: aft_mapped_to_init（当前位姿）
          Enabled: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /aft_mapped_to_init
          Keep: 1
          Position Tolerance: 0.1
          Angle Tolerance: 0.1
          Shape:
            Value: Axes
            Axes Length: 0.5
            Axes Radius: 0.05
          Covariance:
            Value: false
        - Class: rviz_default_plugins/Path
          Name: path（轨迹）
          Enabled: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /path
          Color: 25; 255; 0
          Line Style: Lines
          Alpha: 1
    - Class: rviz_common/Group
      Name: FAST-LIO
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/PointCloud2
          Name: cloud_registered
          Enabled: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /fast_lio/cloud_registered
          Style: Points
          Size (Pixels): 2
          Size (m): 0.03
          Alpha: 1.0
          Decay Time: 10
          Position Transformer: XYZ
          Color Transformer: Intensity
          Use rainbow: true
          Invert Rainbow: false
          Autocompute Intensity Bounds: true
        - Class: rviz_default_plugins/Odometry
          Name: odometry
          Enabled: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /fast_lio/odometry
          Keep: 1
          Position Tolerance: 0.1
          Angle Tolerance: 0.1
          Shape:
            Value: Axes
            Axes Length: 0.5
            Axes Radius: 0.05
          Covariance:
            Value: false
        - Class: rviz_default_plugins/Path
          Name: path
          Enabled: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /fast_lio/path
          Color: 255; 170; 0
          Line Style: Lines
          Alpha: 1
    - Class: rviz_common/Group
      Name: small_point_lio
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/PointCloud2
          Name: cloud_registered
          Enabled: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /small_point_lio/cloud_registered
          Style: Points
          Size (Pixels): 2
          Size (m): 0.03
          Alpha: 1.0
          Decay Time: 10
          Position Transformer: XYZ
          Color Transformer: Intensity
          Use rainbow: true
          Invert Rainbow: false
          Autocompute Intensity Bounds: true
        - Class: rviz_default_plugins/Odometry
          Name: odometry
          Enabled: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /small_point_lio/odometry
          Keep: 1
          Position Tolerance: 0.1
          Angle Tolerance: 0.1
          Shape:
            Value: Axes
            Axes Length: 0.5
            Axes Radius: 0.05
          Covariance:
            Value: false
  Enabled: true
  Global Options:
    Fixed Frame: camera_init
    Background Color: 48; 48; 48
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/PublishPoint
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 25
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.8
      Yaw: 3.9
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 900
  Width: 1500
