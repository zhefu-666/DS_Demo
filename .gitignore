src/lio/point_lio/PCD/*
src/lio/point_lio/Log/*
src/lio/fast_lio/PCD/*
src/lio/fast_lio/Log/*
*.pcd

# 其他
__pycache__/
*.pyc
.vscode/
.idea/
compile_commands.json
*.swp
!src/lio/*/PCD/.gitkeep
